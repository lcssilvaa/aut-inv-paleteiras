# Copie este arquivo para .env e preencha apenas a copia local.
# Nunca coloque credenciais, caminhos pessoais ou destinatarios reais neste exemplo.

# OAuth do Gmail: arquivos locais ignorados pelo Git.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Pasta local ou sincronizada onde estao as bases Excel.
SHAREPOINT_DIR=./dados
ARQUIVO_BASE_1="Gestão Manutenção de Frotas - Controle de Paleteiras.xlsx"
ARQUIVO_BASE_2="Planilha de Paleteiras Disktrans.xlsx"
ABA_BASE_2=Base
PRAZO_DIAS=7
CHECKLIST_ARQUIVO_EQUIPAMENTOS="Base Checklist.xlsx"
CHECKLIST_ARQUIVO_LEITURAS="Especifico Cliente - Relatorio BI - Checklist Veicular.xlsx"
CHECKLIST_PRAZO_DIAS=7

# Destinatarios por grupo; campos vazios nao enviam mensagens.
